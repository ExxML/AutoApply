{
  "name": "autoapply",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Chrome MV3 extension that fills job applications from your profile using Google Gemini.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test --project=e2e",
    "test:live": "npm run build && playwright test --project=live",
    "lint": "eslint . && prettier --check ."
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dom-accessibility-api": "^0.7.1",
    "pdfjs-dist": "^6.4.299",
    "preact": "^10.29.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.1",
    "prettier": "^3.9.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
